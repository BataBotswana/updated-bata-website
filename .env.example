# Local development
NODE_ENV=development
PORT=3000

# Manus OAuth / session
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
JWT_SECRET=
OWNER_OPEN_ID=
OWNER_NAME=

# Supabase Bata e-commerce store Project
NEXT_PUBLIC_SUPABASE_URL=https://iygrjsxueejfucnyozvx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://iygrjsxueejfucnyozvx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ENABLE_SUPABASE_DB=true
NEXT_PUBLIC_WHATSAPP_CATALOG_URL=https://wa.me/c/26775303767

# Legacy MySQL/TiDB catalog database (not used by the public storefront)
DATABASE_URL=

# Managed storage used for product-angle uploads and storefront images
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Supabase Edge Function used by the public storefront to read private bucket assets.
# The function uses Supabase-managed server secrets; never put the service-role key in client code.
# Function URL: https://iygrjsxueejfucnyozvx.supabase.co/functions/v1/bata-storefront

# Optional: only needed when the browser talks directly to a separate API origin.
# The default frontend uses same-origin /api/trpc and Cloudflare Pages Functions proxying.
VITE_API_ORIGIN=

# Cloudflare Pages Functions (set in the Pages project, not in the client bundle)
# API_ORIGIN=https://api.example.com
